generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now())
  reviewed     Case[]   @relation("ReviewedCases")
  cases        Case[]
}

model Case {
  id         Int    @id @default(autoincrement())
  caseNumber String @unique

  // ============================================
  // RELATIONSHIPS
  // ============================================

  userId       Int
  reviewedById Int?

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ReviewedCases", fields: [reviewedById], references: [id])

  // ============================================
  // APPLICANT DETAILS
  // ============================================

  applicantFullName             String
  applicantNationalId           String?
  applicantPhone                String?
  applicantEmail                String?
  applicantAddress              String?
  applicantDistrict             String?
  applicantTraditionalAuthority String?
  applicantVillage              String?
  applicantOccupation           String?

  // ============================================
  // RESPONDENT DETAILS
  // ============================================

  respondentName         String
  respondentPhone        String?
  respondentAddress      String?
  respondentRelationship String?

  // ============================================
  // COMPLAINT DETAILS
  // ============================================

  caseType         String
  complaintDate    DateTime?
  incidentLocation String?
  description      String

  // ============================================
  // LEGAL AID
  // ============================================

  legalAidReason                 String?
  previousLegalAssistance        Boolean @default(false)
  previousLegalAssistanceDetails String?

  // ============================================
  // FINANCIAL INFORMATION
  // ============================================

  employmentStatus       String?
  occupation             String?
  monthlyIncome          Decimal? @db.Decimal(12, 2)
  otherIncome            Decimal? @db.Decimal(12, 2)
  numberOfDependants     Int?
  financialCircumstances String?

  // ============================================
  // CASE STATUS
  // ============================================

  status         CaseStatus @default(PENDING)
  officerComment String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // ============================================
  // CONSULTATION
  // ============================================

  consultationAt     DateTime?
  consultationStatus ConsultationStatus @default(NOT_SCHEDULED)

  // ============================================
  // DOCUMENTS
  // ============================================

  nationalIdFileName String?
  nationalIdUrl      String?

  recommendationFileName String?
  recommendationUrl      String?

  // ============================================
  // INDEXES
  // ============================================

  @@index([userId])
  @@index([status])
  @@index([caseType])
  @@index([createdAt])
}

enum Role {
  CLIENT
  OFFICER
  ADMIN
}

enum CaseStatus {
  PENDING
  APPROVED
  REJECTED
  IN_REVIEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ConsultationStatus {
  NOT_SCHEDULED
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}
